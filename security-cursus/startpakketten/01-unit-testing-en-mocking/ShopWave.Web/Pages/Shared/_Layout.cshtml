<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ShopWave</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <header>
        <div class="container">
            <a class="brand" asp-page="/Index">ShopWave</a>
            <nav>
                <a asp-page="/Producten">Producten</a>
                <a asp-page="/Bestellen">Bestellen</a>
            </nav>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer>
        <div class="container">
            ShopWave - demo-webshop bij de cursus Testing en Security
        </div>
    </footer>
</body>
</html>
