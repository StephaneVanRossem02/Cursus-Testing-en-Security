@page
@model ShopWave.Web.Pages.RegistrerenModel
@{
    ViewData["Title"] = "Registreren";
}

<h1>Registreren</h1>

<div class="uitleg">
    <strong>AccountRepository</strong> uit les 2 slaat je wachtwoord nooit als leesbare
    tekst op: <strong>PasswordHasher</strong> hasht het met BCrypt.
    <strong>PasswordValidator</strong> bepaalt de regels waaraan het moet voldoen.
</div>

@if (Model.Melding != string.Empty)
{
    <div class="melding @(Model.IsFout ? "fout" : "")">@Model.Melding</div>
    <div class="herkomst">Deze melding is letterlijk de returnwaarde van <code>AccountRepository.Register()</code>, de methode die jij schrijft.</div>
}

<form method="post">
    <label for="Email">E-mailadres</label>
    <input type="text" id="Email" name="Email" value="@Model.Email" />

    <label for="Wachtwoord">Wachtwoord</label>
    <input type="password" id="Wachtwoord" name="Wachtwoord" />

    <button type="submit">Account aanmaken</button>
</form>

<p>
    Een geldig wachtwoord is minstens 8 tekens lang en bevat een hoofdletter, een cijfer
    en een speciaal teken uit <code>!@@#$%^&amp;*</code>.
</p>
